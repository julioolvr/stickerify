{
  "name": "stickerify",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "dom-to-image": "^2.6.0",
    "file-saver": "^2.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^1.18.2",
    "react": "^16.9.0",
    "react-dom": "^16.9.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^9.6.1",
    "eslint": "^9.39.1",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^1.1.2"
  },
  "scripts": {
    "start": "npm run watch:css & react-scripts start",
    "build": "npm run build:css && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:css": "postcss src/styles/tailwind.css -o src/tailwind.css",
    "watch:css": "postcss src/styles/tailwind.css -o src/tailwind.css -w"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "git add"
    ]
  }
}
